# Copy to deploy/.env for local or hosted Docker Compose use.
APP_ENV=development
AUTO_CREATE_TABLES=true
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost

# These must be the stable public edge URLs used by clients. Do not use a
# temporary tunnel hostname for a shared or production deployment.
PUBLIC_API_BASE_URL=
PUBLIC_WS_BASE_URL=
PUBLIC_TURN_URL=
PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
EXTERNAL_IP=
METERED_API_KEY=
METERED_DOMAIN=assistme.metered.live

# Only needed when using the optional named Cloudflare Tunnel profile.
CLOUDFLARED_TUNNEL_TOKEN=
