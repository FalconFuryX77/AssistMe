# ==============================================================================
# AssistMe Production Environment Variables Template
# ==============================================================================

# Application Security
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://assistme:assistme_secret_pass@localhost:5432/assistmedb

# WebRTC STUN & TURN Configuration
STUN_SERVER_1=stun:stun.assistme.net:3478
STUN_SERVER_2=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.assistme.net:3478
TURN_SERVER_USERNAME=assistme_turn_user
TURN_SERVER_CREDENTIAL=assistme_turn_secret_key_456

# Domain & SSL
DOMAIN_NAME=assistme.net
SSL_CERT_PATH=/etc/letsencrypt/live/assistme.net/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/assistme.net/privkey.pem
