# Copy to deploy/.env for local or hosted Docker Compose use.
APP_ENV=production
AUTO_CREATE_TABLES=false
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_USER=assistme
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=assistmedb
ALLOWED_ORIGINS=https://api.example.com

# These must be the stable public edge URLs used by clients. Do not use a
# temporary tunnel hostname for a shared or production deployment.
PUBLIC_API_BASE_URL=
PUBLIC_WS_BASE_URL=
PUBLIC_TURN_URL=
PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
EXTERNAL_IP=
METERED_API_KEY=
METERED_DOMAIN=assistme.metered.live

# Only needed when using the optional named Cloudflare Tunnel profile.
CLOUDFLARED_TUNNEL_TOKEN=

# Firebase Admin credential: mount this runtime-only service-account file.
FIREBASE_SERVICE_ACCOUNT=

# Optional OpenAI-compatible MiMo-V2.5 inference endpoint.
AI_PROVIDER=mimo
AI_MODEL=xiaomi/mimo-v2.5
AI_API_KEY=
AI_BASE_URL=
