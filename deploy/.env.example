# ==============================================================================
# AssistMe Production Environment Variables Template
# ==============================================================================

# Application Security
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://assistme:assistme_secret_pass@localhost:5432/assistmedb

# WebRTC STUN & TURN Configuration
STUN_SERVER_1=stun:stun.assistme.net:3478
STUN_SERVER_2=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.assistme.net:3478
TURN_SERVER_USERNAME=assistme_turn_user
TURN_SERVER_CREDENTIAL=assistme_turn_secret_key_456

# Domain & SSL
DOMAIN_NAME=assistme.net
SSL_CERT_PATH=/etc/letsencrypt/live/assistme.net/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/assistme.net/privkey.pem

# --- Internet Deployment (Phase 19) ---
# CORS allowed origins (comma-separated). Use * for dev; restrict in production.
ALLOWED_ORIGINS=https://assistme.net

# Coturn's public IP — required for TURN relay over the internet.
# Set to your server's static public IP (e.g., from ifconfig.me).
EXTERNAL_IP=203.0.113.45

# Public-facing URLs returned to mobile/web clients.
# These must resolve to your server from the internet.
PUBLIC_API_BASE_URL=https://assistme.net/api
PUBLIC_WS_BASE_URL=wss://assistme.net/ws
PUBLIC_TURN_URL=turn:assistme.net:3478
PUBLIC_STUN_URLS=stun:assistme.net:3478,stun:stun.l.google.com:19302

# TURN credentials (customizable)
TURN_USERNAME=assistme_turn_user
TURN_CREDENTIAL=assistme_turn_secret_key_456

