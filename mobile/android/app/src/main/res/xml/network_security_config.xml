<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Enforce HTTPS / TLS for all public domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permit cleartext traffic exclusively on local development IP addresses / LAN subnets -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.39</domain>
        <domain includeSubdomains="true">192.168.1.40</domain>
        <domain includeSubdomains="true">192.168.1.61</domain>
    </domain-config>
</network-security-config>
